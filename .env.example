# Puerto y host. Para que entren otras personas: HOST=0.0.0.0 (ver README: WSL2 mirrored / túnel)
PORT=3000
HOST=127.0.0.1
# URL pública si se expone por túnel (informativo)
PUBLIC_URL=

# Dónde viven los worktrees (rama flock/<slug>)
# WORKTREES_DIR=~/.flockline/worktrees

# mock = agente guionado (sin tokens). real = Claude Agent SDK con la sesión de Claude Code
AGENT_MODE=mock
# CLAUDE_MODEL=
# ANTHROPIC_API_KEY=

# Firma de tokens de sesión
SESSION_SECRET=cambiar-esto
